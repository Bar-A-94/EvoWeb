# Two Qwen3.5-397B (FP8) servers on one 8-GPU box: the agent on GPUs 0-3, the judge on 4-7.
# Used by harness/serve_and_run.sh <this file> <run-id> <samples> <parallelism>. Plain shell: NAME=value.
#
# We validated this layout on a B300 (Blackwell) machine with an internal vLLM 0.28 build; the
# public image below is the default and is untested there. Pass your own with VLLM_IMAGE.
# The agent runs with fp8 KV cache and multi-token-prediction speculation; the judge runs the
# same weights without speculation (it is a vision model, and sees one screenshot per step).

# shared
#VLLM_IMAGE=vllm/vllm-openai:v0.27.0
#HF_CACHE=$HOME/.cache/huggingface
VLLM_DOCKER_ARGS="-e SAFETENSORS_FAST_GPU=1 -e NCCL_IB_DISABLE=1 -e NCCL_NVLS_ENABLE=0 -e NCCL_MNNVL_ENABLE=0 -e VLLM_ALLREDUCE_USE_SYMM_MEM=0 -e OMP_NUM_THREADS=4"

# the agent (model under test)
AGENT_MODEL=Qwen/Qwen3.5-397B-A17B-FP8
AGENT_SERVED_NAME=Qwen/Qwen3.5-397B-A17B
AGENT_GPUS=0,1,2,3
AGENT_PORT=8003
AGENT_VLLM_ARGS='--kv-cache-dtype fp8 --speculative-config {"method":"mtp","num_speculative_tokens":3} --stream-interval 1'

# the judge (WebVoyager's model; must take images)
JUDGE_MODEL=Qwen/Qwen3.5-397B-A17B-FP8
JUDGE_SERVED_NAME=Qwen/Qwen3.5-397B-A17B
JUDGE_GPUS=4,5,6,7
JUDGE_PORT=8004
JUDGE_VLLM_ARGS='--kv-cache-dtype fp8 --stream-interval 1'
JUDGE_IMAGES=4
